#!/bin/sh
# Runs the content checks of tools/release_check.py before every commit and blocks the commit on errors.
# Warnings are shown but do not block. Enabled with:  git config core.hooksPath tools/hooks
# The release-state checks (upload folders, tags, logs) are left to the full run before an upload.

root=$(git rev-parse --show-toplevel)
py=$(command -v python || command -v python3 || command -v py)
if [ -z "$py" ]; then
	echo "pre-commit: python not found, skipping release_check" >&2
	exit 0
fi

echo "pre-commit: running tools/release_check.py (files, loc, refs, balance, scope, pack)..."
PYTHONIOENCODING=utf-8 "$py" "$root/tools/release_check.py" --only files,loc,refs,balance,scope,pack > "$root/.git/release_check_last.txt" 2>&1
status=$?
grep -E "ERROR|error check" "$root/.git/release_check_last.txt"
if [ $status -ne 0 ]; then
	echo "pre-commit: release_check found errors; commit blocked. Full report: .git/release_check_last.txt" >&2
	exit 1
fi
exit 0
